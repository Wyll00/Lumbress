# Variables para el despliegue en Contabo (docker-compose.contabo.yml).
# Copiar a .env junto al compose y rellenar. NO se sube a git.

# Dominio que servira la app (sin https://)
DOMINIO=lumbress.com

# Base de datos (generar con: openssl rand -base64 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Clave de firma de sesiones (generar con: openssl rand -hex 32)
JWT_SECRET=

# Correo — Resend. Si se deja vacio, la app NO envia correos pero funciona:
# el registro con verificacion por codigo quedaria bloqueado, asi que para
# produccion hay que rellenarlo.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Lumbres <no-reply@lumbress.com>

# Stripe (opcional). Sin claves, las suscripciones quedan inactivas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MES=
STRIPE_PRICE_PREMIUM_ANO=
